{% func (p *TagPage) MainBody() %}

<nav class="wk-breadcrumb">
    <a href="/">首页</a><span class="sep">/</span>
    <a href="/tag">标签</a><span class="sep">/</span>
    <span class="current">{%s p.Tag %}</span>
</nav>

<header class="wk-page-head" style="display:flex;align-items:flex-start;gap:16px;padding-bottom:20px;border-bottom:1px solid var(--wk-border);margin-bottom:22px;">
    <div class="ph-icon" style="flex:0 0 auto;width:48px;height:48px;display:grid;place-items:center;border-radius:13px;font-size:20px;font-weight:800;color:var(--wk-tag);background:var(--wk-tag-soft);border:1px solid color-mix(in srgb, var(--wk-tag) 26%, transparent);font-family:var(--wk-mono);">#</div>
    <div style="flex:1;min-width:0;">
        <h1 class="wk-page-title" style="margin:0 0 6px;font-size:26px;font-weight:700;line-height:1.3;color:var(--wk-text);"><span style="color:var(--wk-tag);">#</span>{%s p.Tag %}</h1>
        <p class="wk-page-desc" style="margin:0;font-size:13.5px;color:var(--wk-text-muted);line-height:1.6;">带有此标签的全部文章</p>
    </div>
</header>

<ul class="wk-list">
    {% for _, item := range p.TopicPageInfo.Items %}
    <li class="wk-item">
        <div class="wk-item-avatar">
            {% if item.Comments > 0 %}
            <img alt="{%s item.Title %}" src="/icon/t/{%dul item.ID %}.jpg?r={%dul item.Comments %}" loading="lazy">
            {% else %}
            <img alt="{%s item.Title %}" src="/avatar/{%dul item.UserId %}.jpg" loading="lazy">
            {% endif %}
        </div>
        <div class="wk-item-body">
            <a class="wk-item-title" href="/t/{%dul item.ID %}">{%s item.Title %}</a>
            <div class="wk-item-meta">
                <span class="mi"><a class="wk-chip" href="/n/{%dul item.NodeId %}">{%s item.NodeName %}</a></span>
                <span class="mi">👤 <a href="/member/{%dul item.UserId %}">{%s item.AuthorName %}</a></span>
                <span class="mi">🕘 <time datetime="{%s item.AddTimeFmt %}">{%s item.EditTimeFmt %}</time></span>
                {% if item.Comments > 0 %}
                <a class="wk-comment-pill" href="/t/{%dul item.ID %}#r{%dul item.Comments %}">💬 {%dul item.Comments %}</a>
                {% else %}
                <span class="wk-comment-pill is-zero">💬 0</span>
                {% endif %}
            </div>
        </div>
    </li>
    {% endfor %}
</ul>

<nav class="wk-pagination">
    <span class="wk-page-info">共 <b>{%d len(p.TopicPageInfo.Items) %}</b> 篇</span>
    <div style="display:flex;gap:8px;">
        {% if p.TopicPageInfo.HasPrev %}
        <a class="wk-page-btn" href="/tag/{%s p.Tag %}?btn=prev&key={%dul p.TopicPageInfo.FirstKey %}&score={%dul p.TopicPageInfo.FirstScore %}">← 上一页</a>
        {% else %}
        <span class="wk-page-btn is-disabled">← 上一页</span>
        {% endif %}
        {% if p.TopicPageInfo.HasNext %}
        <a class="wk-page-btn" href="/tag/{%s p.Tag %}?btn=next&key={%dul p.TopicPageInfo.LastKey %}&score={%dul p.TopicPageInfo.LastScore %}">下一页 →</a>
        {% else %}
        <span class="wk-page-btn is-disabled">下一页 →</span>
        {% endif %}
    </div>
</nav>

{% endfunc %}